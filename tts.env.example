# Copia este archivo como tts.env (chmod 600) y pon una clave propia:
#   python3 -c "import secrets;print('sk-tts-'+secrets.token_urlsafe(32))"
TTS_API_KEY=sk-tts-cambia-esta-clave
# Segundos sin uso antes de descargar Qwen3-TTS de la GPU
QWEN_IDLE_SECONDS=300
# Máximo de caracteres por petición con voces de Qwen3-TTS
QWEN_MAX_CHARS=3000
